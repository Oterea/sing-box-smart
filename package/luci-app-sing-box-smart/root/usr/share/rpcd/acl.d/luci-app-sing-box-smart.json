{
  "luci-app-sing-box-smart": {
    "description": "Manage sing-box-smart service",
    "read": {
      "ubus": {
        "service": [
          "list"
        ]
      },
      "file": {
        "/etc/init.d/sing-box-smart enabled": [
          "exec"
        ],
        "/usr/bin/sing-box-smart config-settings read": [
          "exec"
        ],
        "/usr/bin/sing-box-smart config-settings check": [
          "exec"
        ],
        "/usr/libexec/sing-box-smart-update version": [
          "exec"
        ],
        "/usr/libexec/sing-box-smart-update check": [
          "exec"
        ]
      }
    },
    "write": {
      "file": {
        "/etc/init.d/sing-box-smart start": [
          "exec"
        ],
        "/etc/init.d/sing-box-smart stop": [
          "exec"
        ],
        "/etc/init.d/sing-box-smart restart": [
          "exec"
        ],
        "/etc/init.d/sing-box-smart enable": [
          "exec"
        ],
        "/etc/init.d/sing-box-smart disable": [
          "exec"
        ],
        "/usr/bin/sing-box-smart config-settings apply": [
          "exec"
        ],
        "/etc/sing-box-smart/config.pending.json": [
          "write"
        ],
        "/usr/libexec/sing-box-smart-update update": [
          "exec"
        ]
      }
    }
  }
}
