#!/bin/sh
set -eu
status='/tmp/sing-box-smart-update.status'
if [ -d /tmp/sing-box-smart-update.lock ]; then
    printf '%s\n' '更新已经在进行中' >&2
    exit 1
fi
printf '%s\n' '{"state":"starting","message":"正在准备更新","progress":1}' > "$status"
/usr/bin/setsid /usr/libexec/sing-box-smart-update-install >/tmp/sing-box-smart-update.log 2>&1 </dev/null &
printf '%s\n' '更新任务已启动'
