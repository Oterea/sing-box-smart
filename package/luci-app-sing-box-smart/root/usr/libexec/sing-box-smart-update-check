#!/bin/sh
set -eu
manifest_url='https://github.com/Oterea/sing-box-smart/releases/download/latest/sing-box-smart-release.json'
tmp='/tmp/sing-box-smart-update-check.json'
trap 'rm -f "$tmp"' EXIT
uclient-fetch -q -O "$tmp" "$manifest_url" || { printf '%s\n' '无法连接更新源' >&2; exit 1; }
version="$(jsonfilter -i "$tmp" -e '@.version')" || version=''
current="$(opkg status sing-box-smart 2>/dev/null | sed -n 's/^Version: //p' | head -n 1)"
[ -n "$version" ] || { printf '%s\n' '更新清单无效' >&2; exit 1; }
if [ "$version" = "$current" ]; then
    printf '{"available":false,"version":"%s","current":"%s"}\n' "$version" "$current"
else
    printf '{"available":true,"version":"%s","current":"%s"}\n' "$version" "$current"
fi
