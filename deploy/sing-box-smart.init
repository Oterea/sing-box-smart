#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

CONF='/etc/sing-box-smart.conf'

start_service() {
    [ -r "$CONF" ] || return 1
    . "$CONF"
    mkdir -p "$LOG_DIR"
    set -- /usr/bin/sing-box-smart \
        -mode real \
        -settings /etc/sing-box-smart/connection.json \
        -api "$API" \
        -root "$ROOT" \
        -pins "$PINS" \
        -test-url "$TEST_URL" \
        -listen "$LISTEN" \
        -log-dir "$LOG_DIR"
    # Keep older /etc/sing-box-smart.conf files compatible.  Passing an empty
    # value to a boolean Go flag can accidentally enable sleep monitoring.
    if [ "${SLEEP_MONITOR:-0}" = "1" ] || [ "${SLEEP_MONITOR:-0}" = "true" ]; then
        [ -n "${GRPC_ADDR:-}" ] || return 1
        set -- "$@" \
            -grpc "$GRPC_ADDR" \
            -grpc-secret "${GRPC_SECRET:-}" \
            -sleep-monitor=true \
            -sleep-idle "${SLEEP_IDLE:-10m}"
    fi
    procd_open_instance
    procd_set_param command "$@"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
