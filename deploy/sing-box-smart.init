#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

start_service() {
    mkdir -p /var/log/sing-box-smart
    set -- /usr/bin/sing-box-smart \
        -mode real \
        -settings /etc/sing-box-smart/connection.json
    procd_open_instance
    procd_set_param command "$@"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
