#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

CONF='/etc/sing-box-smart.conf'

start_service() {
    [ -r "$CONF" ] || return 1
    . "$CONF"
    mkdir -p "$LOG_DIR"
    procd_open_instance
    procd_set_param command /usr/bin/sing-box-smart \
        -mode real \
        -settings /etc/sing-box-smart/connection.json \
        -api "$API" \
        -root "$ROOT" \
        -pins "$PINS" \
        -test-url "$TEST_URL" \
        -listen "$LISTEN" \
        -log-dir "$LOG_DIR"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
