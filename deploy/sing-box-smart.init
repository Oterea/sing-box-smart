#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

CONF='/etc/sing-box-smart.conf'

start_service() {
    [ -r "$CONF" ] || return 1
    . "$CONF"
    mkdir -p "$LOG_DIR"
    set -- /usr/bin/sing-box-smart \
        -mode real \
        -settings /etc/sing-box-smart/connection.json \
        -api "$API" \
        -root "$ROOT" \
        -pins "$PINS" \
        -test-url "$TEST_URL" \
        -listen "$LISTEN" \
        -log-dir "$LOG_DIR"
    # Always pass transport and sleep defaults; the runtime settings file can
    # enable monitoring later without changing startup flags.
    sleep_enabled=false
    if [ "${SLEEP_MONITOR:-0}" = "1" ] || [ "${SLEEP_MONITOR:-0}" = "true" ]; then
        sleep_enabled=true
    fi
    set -- "$@" \
        -grpc "${GRPC_ADDR:-}" \
        -grpc-secret "${GRPC_SECRET:-}" \
        -sleep-monitor="$sleep_enabled" \
        -sleep-idle "${SLEEP_IDLE:-10m}" \
        -sleep-quiet-bytes "${SLEEP_QUIET_BYTES:-65536}" \
        -sleep-wake-window "${SLEEP_WAKE_WINDOW:-5s}" \
        -sleep-wake-bytes "${SLEEP_WAKE_BYTES:-1048576}"
    procd_open_instance
    procd_set_param command "$@"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
